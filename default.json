{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:daily"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "commitMessagePrefix": "chore(deps/github-actions):"
    },
    {
      "matchManagers": ["terraform"],
      "groupName": "terraform",
      "commitMessagePrefix": "chore(deps/terraform):"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm",
      "commitMessagePrefix": "chore(deps/npm):"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "golang",
      "commitMessagePrefix": "chore(deps/golang):",
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "matchManagers": ["pub"],
      "groupName": "dart",
      "commitMessagePrefix": "chore(deps/dart):"
    },
    {
      "description": "TypeScript 7 is the Go-ported compiler with a restructured package (no more typescript/lib/tsc export). vue-tsc and typescript-eslint, which the Nuxt sites use, don't support it yet; revisit once they do.",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
