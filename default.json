{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:daily"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "commitMessagePrefix": "chore(deps/github-actions):"
    },
    {
      "matchManagers": ["terraform"],
      "groupName": "terraform",
      "commitMessagePrefix": "chore(deps/terraform):"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm",
      "commitMessagePrefix": "chore(deps/npm):"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "golang",
      "commitMessagePrefix": "chore(deps/golang):",
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "matchManagers": ["pub"],
      "groupName": "dart",
      "commitMessagePrefix": "chore(deps/dart):"
    }
  ]
}
